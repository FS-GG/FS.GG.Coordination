<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>true</IsPackable>
    <PackageId>FS.GG.Execution.Processes</PackageId>
    <Version>0.3.0</Version>
    <PackageVersion>0.3.0</PackageVersion>
    <Authors>FS-GG</Authors>
    <Description>Caller-retained BCL process sessions with bounded observation and explicit best-effort retirement policies.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/FS-GG/FS.GG.Coordination</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" /><Compile Include="BoundedText.fs" /><Compile Include="ProcessSessions.fsi" /><Compile Include="ProcessSessions.fs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="*.fsi" Pack="true" PackagePath="api/" />
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../FS.GG.Execution.Contracts/FS.GG.Execution.Contracts.fsproj" /></ItemGroup>
</Project>
