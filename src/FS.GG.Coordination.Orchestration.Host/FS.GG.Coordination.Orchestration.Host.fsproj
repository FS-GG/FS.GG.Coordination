<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>fsgg-coord-orchestration-host</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <IsPackable>false</IsPackable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <FsggSourceRevision Condition="'$(FsggSourceRevision)' == ''">0000000000000000000000000000000000000000</FsggSourceRevision>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="FsggSourceRevision" Value="$(FsggSourceRevision)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\FS.GG.Coordination.Orchestration.Runner.Client\TelemetryCliPublisher.fs" Link="TelemetryCliPublisher.fs" />
    <Compile Include="HostConfiguration.fs" />
    <Compile Include="HostInitialization.fs" />
    <Compile Include="HostedWriterRuntime.fs" />
    <Compile Include="RemoteExecutorProvider.fs" />
    <Compile Include="LocalExecutorTransport.fs" />
    <Compile Include="HostExecutorRelay.fs" />
    <Compile Include="GitHubRouteClient.fs" />
    <Compile Include="TelemetryOutcomeBridge.fs" />
    <Compile Include="MainEffectDriver.fs" />
    <Compile Include="MainRouteAdmission.fs" />
    <Compile Include="MainAdmissionPreparer.fs" />
    <Compile Include="InstalledAdoptionVerification.fs" />
    <Compile Include="MainRouteWorkflow.fs" />
    <Compile Include="MainProductionCallbacks.fs" />
    <Compile Include="MainHostComposition.fs" />
    <Compile Include="RunnerWireRuntime.fs" />
    <Compile Include="HostRuntime.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FS.GG.Coordination.Core\FS.GG.Coordination.Core.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Orchestration.Pilot\FS.GG.Coordination.Orchestration.Pilot.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Orchestration.PostgreSql\FS.GG.Coordination.Orchestration.PostgreSql.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Orchestration.Runner.Protocol\FS.GG.Coordination.Orchestration.Runner.Protocol.fsproj" />
  </ItemGroup>
</Project>
