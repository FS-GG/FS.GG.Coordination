<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><None Include="README.md" /><Compile Include="Execution.fs" /><Compile Include="PortableWorkspaceContract.fs" /><Compile Include="PortableWorkspaceAdapter.fs" /><Compile Include="CustodyBootstrap.fs" /><Compile Include="PreparedAttempt.fs" /><Compile Include="PortableWorkspaceExecutor.fs" /><Compile Include="PortableWorkspacePodmanRunner.fs" /><Compile Include="LearningSelectionEvidence.fs" /><Compile Include="LearningOperationalWindow.fs" /><Compile Include="LearningExecutionBinding.fs" /><Compile Include="SessionCodec.fs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Akka" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Custody/bootstrap.c" LogicalName="FSGG.Custody.bootstrap.c" />
    <EmbeddedResource Include="Custody/bootstrap.linux-x64.bin" LogicalName="FSGG.Custody.bootstrap.linux-x64.bin" />
    <EmbeddedResource Include="Custody/filter.linux-x64.bpf" LogicalName="FSGG.Custody.filter.linux-x64.bpf" />
    <EmbeddedResource Include="Custody/manifest.json" LogicalName="FSGG.Custody.manifest.json" />
  </ItemGroup>
</Project>
