<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsgg-coordination</ToolCommandName>
    <PackageId>FS.GG.Coordination.Cli</PackageId>
    <Version>0.1.2</Version>
    <PackageVersion>0.1.2</PackageVersion>
    <Authors>FS-GG</Authors>
    <Description>Callable FS.GG Coordination boundary. Production effects remain governed by authoritative epoch and journal policy.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/FS-GG/FS.GG.Coordination</RepositoryUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <Compile Include="RoadmapCommand.fs" />
    <Compile Include="QualificationManifestCommand.fs" />
    <Compile Include="WorkflowSelectionCommand.fs" />
    <Compile Include="LedgerProtectionCommand.fs" />
    <Compile Include="ObserverViewCommand.fs" />
    <Compile Include="DeliveryCommand.fs" />
    <Compile Include="InstalledOrdinarySettlementProvider.fs" />
    <Compile Include="MigrationInspectProviderAdapter.fsi" />
    <Compile Include="MigrationInspectProviderAdapter.fs" />
    <Compile Include="MigrationReceiverCapture.fsi" />
    <Compile Include="MigrationReceiverCapture.fs" />
    <Compile Include="MigrationRollbackReceiverReadback.fsi" />
    <Compile Include="MigrationRollbackReceiverReadback.fs" />
    <Compile Include="MigrationRollbackSettingsReadback.fsi" />
    <Compile Include="MigrationRollbackSettingsReadback.fs" />
    <Compile Include="MigrationSandboxFixtureSeed.fsi" />
    <Compile Include="MigrationSandboxFixtureSeed.fs" />
    <Compile Include="MigrationSandboxProviderObservation.fsi" />
    <Compile Include="MigrationSandboxProviderObservation.fs" />
    <Compile Include="OrdinarySettlementCommand.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FS.GG.Coordination.Protocol\FS.GG.Coordination.Protocol.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Core\FS.GG.Coordination.Core.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.GitHub\FS.GG.Coordination.GitHub.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Qualification.Contracts\FS.GG.Coordination.Qualification.Contracts.fsproj" />
    <ProjectReference Include="..\FS.GG.Coordination.Orchestration.Observer\FS.GG.Coordination.Orchestration.Observer.fsproj" />
  </ItemGroup>

</Project>
