# Generated by eng/generate-optimistic-validation-workflow.fsx from eng/optimistic-qualification-plan.json.
# Candidate obligations and receipts are artifacts only; this workflow never commits status Markdown.
name: Optimistic parallel validation

on:
  pull_request:
  merge_group:
  push:
    branches: [main]
  schedule:
    - cron: '17 3 * * *'
  workflow_dispatch:
    inputs:
      candidate_sha:
        description: Immutable pending candidate selected by bounded recovery.
        required: false
        type: string
      base_sha:
        description: Immutable protected-main base observed by recovery.
        required: false
        type: string

permissions:
  actions: write
  contents: read
  pull-requests: read

concurrency:
  # Candidate identity, rather than pull-request identity, lets immutable heads
  # overlap while preserving every rerun for the same candidate.
  group: optimistic-coherent-${{ inputs.candidate_sha || github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}
  cancel-in-progress: false

jobs:
  prepare:
    runs-on: ubuntu-latest
    outputs:
      candidate: ${{ steps.identity.outputs.candidate }}
      base: ${{ steps.identity.outputs.base }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ inputs.candidate_sha || github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}', fetch-depth: 0 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - id: identity
        shell: bash
        run: |
          set -euo pipefail
          printf 'candidate=%s\n' '${{ inputs.candidate_sha || github.event.pull_request.head.sha || github.event.merge_group.head_sha || github.sha }}' >> "$GITHUB_OUTPUT"
          printf 'base=%s\n' '${{ inputs.base_sha || github.event.pull_request.base.sha || github.event.merge_group.base_sha || github.event.before || github.sha }}' >> "$GITHUB_OUTPUT"
      - name: Enumerate protected-main ancestry and every pending candidate
        if: ${{ github.event_name == 'schedule' }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: bash eng/bootstrap-gates/optimistic-recovery.sh
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: ${{ github.event_name == 'schedule' }}
        with:
          name: optimistic-recovery-cursor
          path: ${{ runner.temp }}/optimistic-validation/recovery-cursor.json
          retention-days: 90
          if-no-files-found: ignore
      - name: Prepare immutable content-addressed obligation
        env:
          FSGG_CANDIDATE_SHA: ${{ steps.identity.outputs.candidate }}
          FSGG_BASE_SHA: ${{ steps.identity.outputs.base }}
        run: bash eng/bootstrap-gates/optimistic-prepare.sh
      - name: Dispatch bounded nightly recovery candidates
        if: ${{ github.event_name == 'schedule' }}
        env:
          GH_TOKEN: ${{ github.token }}
        run: bash eng/bootstrap-gates/optimistic-dispatch-recovery.sh "${{ runner.temp }}/optimistic-validation/pending-candidates.txt"
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: candidate-obligation-${{ steps.identity.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
          retention-days: 90
          if-no-files-found: error

  classify-reuse:
    needs: prepare
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}', fetch-depth: 0 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: candidate-obligation-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
      - name: Independently classify selective reuse
        env:
          GH_TOKEN: ${{ github.token }}
        run: bash eng/bootstrap-gates/optimistic-classify.sh
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: qualification-selection-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-selection/selection.json
          retention-days: 90
          if-no-files-found: error

  shared-build:
    # Cheap reuse classification is the admission boundary. Once accepted,
    # this coherent lane and native delivery may proceed independently.
    needs: [prepare, classify-reuse]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}', fetch-depth: 1 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - run: dotnet restore FS.GG.Coordination.sln --locked-mode
      - run: dotnet build FS.GG.Coordination.sln -c Release --no-restore --nologo
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: shared-build-${{ needs.prepare.outputs.candidate }}
          path: |
            src/**/bin/Release/**
            src/**/obj/**
            tests/**/bin/Release/**
            tests/**/obj/**
          if-no-files-found: error

  formal-prepare:
    needs: [prepare, classify-reuse]
    runs-on: ubuntu-latest
    env:
      FSGG_QUINT_TOOLCHAIN_OUTPUT: /tmp/fsgg-${{ github.run_id }}-formal-toolchain/toolchain.tar.gz
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}', fetch-depth: 1 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - name: Prepare the pinned canonical toolchain once
        run: bash eng/bootstrap-gates/canonical-quint-prepare.sh
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: coherent-formal-toolchain-${{ needs.prepare.outputs.candidate }}
          path: ${{ env.FSGG_QUINT_TOOLCHAIN_OUTPUT }}
          if-no-files-found: error

  run-partition:
    name: coherent-execution (${{ matrix.kind }}-${{ matrix.partition }}${{ matrix.shard }})
    needs: [prepare, shared-build, formal-prepare]
    strategy:
      fail-fast: false
      max-parallel: 6
      matrix:
        include:
          - { kind: formal, shard: base }
          - { kind: partition, partition: 0 }
          - { kind: partition, partition: 2 }
          - { kind: partition, partition: 3 }
          - { kind: partition, partition: 4 }
          - { kind: partition, partition: 5 }
          - { kind: formal, shard: authority-reconciliation }
          - { kind: formal, shard: claim-election }
          - { kind: formal, shard: cutover-observation }
          - { kind: formal, shard: hosted-writer-fault-safety }
          - { kind: formal, shard: hosted-writer-progress }
          - { kind: formal, shard: journal-fencing }
          - { kind: formal, shard: journal-reconciliation }
          - { kind: formal, shard: lifecycle }
          - { kind: formal, shard: operation-saga }
          - { kind: formal, shard: pilot-permit-fault-safety }
          - { kind: formal, shard: pilot-permit-major-action-coverage }
          - { kind: formal, shard: pilot-permit-transfer }
          - { kind: formal, shard: relation-mutation }
          - { kind: formal, shard: review-epoch }
          - { kind: formal, shard: rollback }
          - { kind: formal, shard: administrative-retirement-closure }
          - { kind: formal, shard: administrative-retirement-race }
          - { kind: formal, shard: administrative-retirement-old-plan-counterexample }
          - { kind: formal, shard: epoch }
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}', fetch-depth: 0 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: candidate-obligation-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        if: ${{ matrix.kind == 'partition' && (matrix.partition == 0 || matrix.partition == 5) }}
        with:
          name: shared-build-${{ needs.prepare.outputs.candidate }}
          path: .
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        if: ${{ matrix.kind == 'formal' || matrix.partition == 0 }}
        with:
          name: coherent-formal-toolchain-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/canonical-quint-toolchain
      - name: Bind the prepared Quint toolchain for architecture tests
        if: ${{ matrix.kind == 'partition' && matrix.partition == 0 }}
        run: printf 'FSGG_QUINT_TOOLCHAIN_ARCHIVE=%s\n' '${{ runner.temp }}/canonical-quint-toolchain/toolchain.tar.gz' >> "$GITHUB_ENV"
      - name: Run isolated coherent nonformal partition
        if: ${{ matrix.kind == 'partition' }}
        env:
          FSGG_PARTITION: ${{ matrix.partition }}
          NUGET_PACKAGES: ${{ runner.temp }}/nuget-${{ matrix.partition }}
        run: bash eng/bootstrap-gates/optimistic-run-partition.sh
      - name: Run one independently isolated formal shard
        if: ${{ matrix.kind == 'formal' && (matrix.shard != 'authority-reconciliation' || github.event_name != 'pull_request') }}
        env:
          FSGG_QUINT_SHARD: ${{ matrix.shard }}
          FSGG_QUINT_TOOLCHAIN_ARCHIVE: ${{ runner.temp }}/canonical-quint-toolchain/toolchain.tar.gz
          NUGET_PACKAGES: ${{ runner.temp }}/nuget-formal-${{ matrix.shard }}
        run: bash eng/optimistic-run-formal-fragment.sh
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: ${{ always() && matrix.kind == 'partition' }}
        with:
          name: coherent-partition-${{ needs.prepare.outputs.candidate }}-${{ matrix.partition }}
          path: ${{ runner.temp }}/coherent-partition-${{ matrix.partition }}
          if-no-files-found: error
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: ${{ always() && matrix.kind == 'formal' && (matrix.shard != 'authority-reconciliation' || github.event_name != 'pull_request') }}
        with:
          name: coherent-formal-fragment-${{ needs.prepare.outputs.candidate }}-${{ matrix.shard }}
          path: ${{ runner.temp }}/coherent-formal-fragment-${{ matrix.shard }}
          if-no-files-found: error

  offline-formal-shadow:
    # Only pull requests use signed offline evidence for this pilot. Push,
    # merge-group, schedule and dispatch retain the hosted authority shard.
    if: ${{ github.event_name == 'pull_request' }}
    needs: [prepare, classify-reuse, shared-build, formal-prepare]
    runs-on: ubuntu-latest
    env:
      FSGG_CANDIDATE_SHA: ${{ needs.prepare.outputs.candidate }}
      FSGG_BASE_SHA: ${{ needs.prepare.outputs.base }}
      FSGG_CANDIDATE_ROOT: ${{ github.workspace }}/candidate
      FSGG_TRUSTED_ROOT: ${{ github.workspace }}/trusted
      FSGG_OFFLINE_PUBLIC_KEY: ${{ github.workspace }}/trusted/eng/offline-formal-pilot.pub.pem
      FSGG_CANDIDATE_OBLIGATION: /tmp/fsgg-${{ github.run_id }}-offline-obligation/candidate-obligation.json
      FSGG_PARTITION_PLAN: /tmp/fsgg-${{ github.run_id }}-offline-obligation/partition-plan.json
      FSGG_OFFLINE_EVIDENCE: /tmp/fsgg-${{ github.run_id }}-offline-formal-envelope.json
      FSGG_OFFLINE_FRAGMENT_ROOT: /tmp/fsgg-${{ github.run_id }}-coherent-formal-fragment-authority-reconciliation
    steps:
      - name: Check out the exact candidate separately
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ needs.prepare.outputs.candidate }}
          path: candidate
          fetch-depth: 0
      - name: Check out the protected base verifier separately
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ needs.prepare.outputs.base }}
          path: trusted
          fetch-depth: 0
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: candidate-obligation-${{ needs.prepare.outputs.candidate }}
          path: /tmp/fsgg-${{ github.run_id }}-offline-obligation
      - name: Fetch the exact public signed envelope
        run: bash "$FSGG_TRUSTED_ROOT/eng/offline-formal-fetch.sh"
      - name: Verify and assemble the normal formal fragment
        run: bash "$FSGG_TRUSTED_ROOT/eng/offline-formal-join.sh"
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: coherent-formal-fragment-${{ needs.prepare.outputs.candidate }}-authority-reconciliation
          path: ${{ env.FSGG_OFFLINE_FRAGMENT_ROOT }}
          if-no-files-found: error

  formal-aggregate:
    needs: [prepare, run-partition, offline-formal-shadow]
    if: ${{ always() }}
    runs-on: ubuntu-latest
    env:
      FSGG_FORMAL_FRAGMENT_ROOT: /tmp/fsgg-${{ github.run_id }}-coherent-formal-fragments
      FSGG_FORMAL_OUTPUT_ROOT: /tmp/fsgg-${{ github.run_id }}-coherent-partition-1
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}', fetch-depth: 1 }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          pattern: coherent-formal-fragment-${{ needs.prepare.outputs.candidate }}-*
          path: ${{ env.FSGG_FORMAL_FRAGMENT_ROOT }}
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: candidate-obligation-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
      - name: Aggregate a complete candidate-bound formal partition
        run: bash eng/optimistic-aggregate-formal.sh
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        if: ${{ always() }}
        with:
          name: coherent-partition-${{ needs.prepare.outputs.candidate }}-1
          path: ${{ env.FSGG_FORMAL_OUTPUT_ROOT }}
          if-no-files-found: error

  aggregate:
    needs: [prepare, classify-reuse, run-partition, formal-aggregate]
    if: ${{ always() }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with: { ref: '${{ needs.prepare.outputs.candidate }}' }
      - uses: actions/setup-dotnet@a98b56852c35b8e3190ac28c8c2271da59106c68
        with: { dotnet-version: 10.0.400 }
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          pattern: coherent-partition-${{ needs.prepare.outputs.candidate }}-*
          path: ${{ runner.temp }}/coherent-partitions
      - uses: actions/download-artifact@3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c
        with:
          name: candidate-obligation-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
      - name: Aggregate complete deterministic coverage
        run: bash eng/bootstrap-gates/optimistic-aggregate.sh "${{ runner.temp }}/coherent-partitions" "${{ runner.temp }}/optimistic-validation"
      - uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a
        with:
          name: coherent-aggregate-${{ needs.prepare.outputs.candidate }}
          path: ${{ runner.temp }}/optimistic-validation
          retention-days: 90
          if-no-files-found: error
