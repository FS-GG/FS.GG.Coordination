{
  "schema": "fsgg.coordination.bootstrap-qualification-plan/2",
  "evidenceSchema": "fsgg.coordination.bootstrap-evidence/2",
  "actions": {
    "checkout": "3d3c42e5aac5ba805825da76410c181273ba90b1",
    "setupDotnet": "a98b56852c35b8e3190ac28c8c2271da59106c68",
    "uploadArtifact": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
    "downloadArtifact": "3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c"
  },
  "actionRuntimes": {
    "checkout": "node24",
    "setupDotnet": "node24",
    "uploadArtifact": "node24",
    "downloadArtifact": "node24"
  },
  "triggers": ["pull_request", "push:main"],
  "permissions": ["contents:read"],
  "concurrency": {
    "group": "bootstrap-qualification-${{ github.ref }}",
    "cancelInProgress": true
  },
  "requiredGateCount": 7,
  "requiredProjectCount": 8,
  "requiredVulnerabilitySources": ["https://api.nuget.org/v3/index.json"],
  "requiredProjects": [
    "src/FS.GG.Coordination.App/FS.GG.Coordination.App.fsproj",
    "src/FS.GG.Coordination.Cli/FS.GG.Coordination.Cli.fsproj",
    "src/FS.GG.Coordination.Core/FS.GG.Coordination.Core.fsproj",
    "src/FS.GG.Coordination.GitHub/FS.GG.Coordination.GitHub.fsproj",
    "src/FS.GG.Coordination.Protocol/FS.GG.Coordination.Protocol.fsproj",
    "src/FS.GG.Coordination.Qualification.Contracts/FS.GG.Coordination.Qualification.Contracts.fsproj",
    "tests/FS.GG.Coordination.ArchitectureTests/FS.GG.Coordination.ArchitectureTests.fsproj",
    "tests/FS.GG.Coordination.UnitTests/FS.GG.Coordination.UnitTests.fsproj"
  ],
  "jobs": [
    {
      "id": "deterministic-build",
      "artifact": "deterministic-build/protocol.dll",
      "timeoutMinutes": 15,
      "entryPoint": "bash eng/bootstrap-gates/deterministic-build.sh",
      "fetchDepth": 1,
      "alwaysUpload": false,
      "downloadArtifacts": false,
      "environment": {},
      "uploadName": "deterministic-build",
      "uploadPath": "${{ runner.temp }}/deterministic-build/protocol.dll",
      "needs": []
    },
    {
      "id": "compiler-and-tests",
      "artifact": "compiler-and-tests/architecture.trx",
      "timeoutMinutes": 20,
      "entryPoint": "bash eng/bootstrap-gates/compiler-and-tests.sh",
      "fetchDepth": 1,
      "alwaysUpload": false,
      "downloadArtifacts": false,
      "environment": {},
      "uploadName": "compiler-and-tests",
      "uploadPath": "${{ runner.temp }}/compiler-and-tests/architecture.trx",
      "needs": []
    },
    {
      "id": "canonical-quint",
      "artifact": "canonical-quint/qualification.json",
      "timeoutMinutes": 25,
      "entryPoint": "bash eng/bootstrap-gates/canonical-quint.sh",
      "fetchDepth": 1,
      "alwaysUpload": true,
      "downloadArtifacts": false,
      "environment": {
        "NUGET_PACKAGES": "/tmp/fsgg-${{ github.run_id }}-nuget-canonical-quint",
        "FSGG_QUINT_RECEIPT": "/tmp/fsgg-${{ github.run_id }}-canonical-quint/qualification.json"
      },
      "uploadName": "canonical-quint",
      "uploadPath": "${{ env.FSGG_QUINT_RECEIPT }}",
      "receiptKind": "formal",
      "needs": []
    },
    {
      "id": "dependency-and-security",
      "artifact": "dependency-and-security/vulnerability-report.json",
      "timeoutMinutes": 15,
      "entryPoint": "bash eng/bootstrap-gates/dependency-and-security.sh",
      "fetchDepth": 1,
      "alwaysUpload": false,
      "downloadArtifacts": false,
      "environment": {
        "NUGET_PACKAGES": "/tmp/fsgg-${{ github.run_id }}-nuget-dependency-and-security"
      },
      "uploadName": "dependency-and-security",
      "uploadPath": "${{ runner.temp }}/dependency-and-security/vulnerability-report.json",
      "needs": []
    },
    {
      "id": "package-install-smoke",
      "artifact": "package-install-smoke/FS.GG.Coordination.Protocol.0.0.0-bootstrap.nupkg",
      "timeoutMinutes": 15,
      "entryPoint": "bash eng/bootstrap-gates/package-install-smoke.sh",
      "fetchDepth": 1,
      "alwaysUpload": false,
      "downloadArtifacts": false,
      "environment": {},
      "uploadName": "package-install-smoke",
      "uploadPath": "${{ runner.temp }}/package-install-smoke/FS.GG.Coordination.Protocol.0.0.0-bootstrap.nupkg",
      "needs": []
    },
    {
      "id": "bootstrap-recovery",
      "artifact": "bootstrap-recovery/result.json",
      "timeoutMinutes": 25,
      "entryPoint": "bash eng/bootstrap-gates/bootstrap-recovery.sh",
      "fetchDepth": 0,
      "alwaysUpload": false,
      "downloadArtifacts": false,
      "environment": {},
      "uploadName": "bootstrap-recovery",
      "uploadPath": "${{ runner.temp }}/bootstrap-recovery/result.json",
      "receiptKind": "recovery",
      "needs": []
    },
    {
      "id": "evidence-manifest",
      "artifact": "evidence-manifest/plan.json",
      "timeoutMinutes": 10,
      "entryPoint": "bash eng/bootstrap-gates/evidence-manifest.sh",
      "fetchDepth": 1,
      "alwaysUpload": false,
      "downloadArtifacts": true,
      "environment": {
        "NUGET_PACKAGES": "/tmp/fsgg-${{ github.run_id }}-nuget-evidence-manifest",
        "FSGG_CANDIDATE_SHA": "${{ github.event.pull_request.head.sha || github.sha }}"
      },
      "uploadName": "bootstrap-evidence-manifest",
      "uploadPath": "${{ runner.temp }}/bootstrap-evidence.json",
      "needs": ["deterministic-build", "compiler-and-tests", "canonical-quint", "dependency-and-security", "package-install-smoke", "bootstrap-recovery"]
    }
  ]
}
