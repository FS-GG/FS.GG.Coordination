{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://fs-gg.github.io/schemas/evidence/accepted-receipts/v1","category":"accepted-receipts","type":"object","required":["schema","unitId","state","unitContractSha256","sourceRevision","artifacts","acceptedAt","digest"],"properties":{"schema":{"const":"fsgg.coordination.unit-acceptance/1"},"unitId":{"type":"string","pattern":"^GS2-[0-9]{2}\\.[0-9]+$"},"state":{"const":"accepted"},"unitContractSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"sourceRevision":{"type":"string","pattern":"^[0-9a-f]{40}$"},"artifacts":{"type":"array","minItems":1,"items":{"type":"object","required":["name","sha256"],"properties":{"name":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}},"acceptedAt":{"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"additionalProperties":false}
