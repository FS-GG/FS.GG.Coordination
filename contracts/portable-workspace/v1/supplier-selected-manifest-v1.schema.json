{
  "$comment": "Schema is structural only. The codecs additionally enforce exact C1, checked u64, ordered distinct non-ancestor paths and summary joins.",
  "$id": "fsgg.v3.selected-manifest/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "members": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "maxLength": 20,
            "pattern": "^(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "path": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._/-]+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "bytes",
          "path",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
    },
    "schema": {
      "const": "fsgg.v3.selected-manifest/1"
    }
  },
  "required": [
    "members",
    "schema"
  ],
  "type": "object",
  "x-canonical-max-bytes": 6000
}
