{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs.gg/contracts/portable-workspace/v1/result.schema.json",
  "title": "FS.GG portable workspace result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "commandId", "workflowRevision", "fenceGeneration", "completedAt", "exitCode", "artifactReference"],
  "properties": {
    "schema": { "const": "fsgg.workspace.result/1" },
    "commandId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "workflowRevision": { "$ref": "#/$defs/counter" },
    "fenceGeneration": { "$ref": "#/$defs/counter" },
    "completedAt": { "$ref": "#/$defs/timestamp" },
    "exitCode": { "$ref": "#/$defs/integerEvidence" },
    "artifactReference": { "$ref": "#/$defs/stringEvidence" },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message", "retryable", "details"],
      "properties": {
        "code": { "$ref": "#/$defs/id" }, "message": { "type": "string", "minLength": 1, "maxLength": 512 }, "retryable": { "type": "boolean" },
        "details": { "type": "object", "maxProperties": 32, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 512 } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "counter": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$" },
    "integerEvidence": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "const": "known" }, "value": { "type": "integer" } } }, { "$ref": "#/$defs/missingEvidence" }, { "$ref": "#/$defs/unknownEvidence" } ] },
    "stringEvidence": { "oneOf": [ { "type": "object", "additionalProperties": false, "required": ["state", "value"], "properties": { "state": { "const": "known" }, "value": { "type": "string", "minLength": 1 } } }, { "$ref": "#/$defs/missingEvidence" }, { "$ref": "#/$defs/unknownEvidence" } ] },
    "missingEvidence": { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "const": "missing" }, "reason": { "type": "string", "minLength": 1, "maxLength": 256 } } },
    "unknownEvidence": { "type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": { "state": { "const": "unknown" }, "reason": { "type": "string", "minLength": 1, "maxLength": 256 } } }
  }
}
