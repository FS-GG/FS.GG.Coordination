{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fs.gg/contracts/portable-workspace/v1/command.schema.json",
  "title": "FS.GG portable workspace command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "commandId", "idempotencyId", "workspaceScope", "profileId", "profileRevision", "sourceRevision", "expectedWorkflowRevision", "fenceGeneration", "deadline", "operation"],
  "properties": {
    "schema": { "const": "fsgg.workspace.command/1" },
    "commandId": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "idempotencyId": { "$ref": "#/$defs/id" },
    "workspaceScope": { "$ref": "#/$defs/id" },
    "profileId": { "$ref": "#/$defs/id" },
    "profileRevision": { "$ref": "#/$defs/counter" },
    "sourceRevision": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" },
    "expectedWorkflowRevision": { "$ref": "#/$defs/counter" },
    "fenceGeneration": { "$ref": "#/$defs/counter" },
    "causationId": { "$ref": "#/$defs/id" },
    "deadline": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$" },
    "operation": { "enum": ["build", "test", "lint", "artifact", "journey"] },
    "componentId": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "counter": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$" }
  }
}
