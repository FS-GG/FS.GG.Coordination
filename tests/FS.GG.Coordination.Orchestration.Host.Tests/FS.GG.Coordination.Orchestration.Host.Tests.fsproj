<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="ChoreoTrace.fs" />
    <Compile Include="ChoreoTraceTests.fs" />
    <Compile Include="LearningTrace.fs" />
    <Compile Include="LearningTraceTests.fs" />
    <Compile Include="HostedWriterQuintReplayTests.fs" />
    <Compile Include="HostedWriterRuntimeTests.fs" />
    <Compile Include="AguiReadOnlyProjectionTests.fs" />
    <Compile Include="RunnerWireTests.fs" />
    <Compile Include="RunnerWireRuntimeTests.fs" />
    <Compile Include="InstalledAdoptionVerificationTests.fs" />
    <Compile Include="CompatibilityDiagnosticTests.fs" />
    <Compile Include="FixedNativeCapabilityDiagnosticTests.fs" />
    <Compile Include="HostTests.fs" />
    <Compile Include="LearningInstalledReadinessSourceTests.fs" />
    <Compile Include="LearningJournalReadinessSourceTests.fs" />
    <Compile Include="LearningTelemetryReadinessSourceTests.fs" />
    <Compile Include="LearningHostCompositionTests.fs" />
    <Compile Include="LearningRuntimeCorrespondenceTests.fs" />
    <Compile Include="ChoreoProductionReplayTests.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FsQuint" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FS.GG.Coordination.Orchestration.Host\FS.GG.Coordination.Orchestration.Host.fsproj" />
    <ProjectReference Include="..\..\src\FS.GG.Coordination.Orchestration.Runner.Client\FS.GG.Coordination.Orchestration.Runner.Client.fsproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\src\FS.GG.Coordination.Protocol\Protocol.md"
             Link="Fixtures\Protocol.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Choreo\**\*"
             Link="Fixtures\Choreo\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Learning\**\*"
             Link="Fixtures\Learning\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\Agui\python-sse-client.py"
             Link="Fixtures\Agui\python-sse-client.py"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
