<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <RollForward>Disable</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CliWrap" Version="[3.10.5]" />
    <PackageReference Include="ProcessKit" Version="[2.12.0]" />
    <PackageReference Include="FSharp.Core" Version="[10.1.300]" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[10.0.11]" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="[10.0.11]" />
  </ItemGroup>
</Project>
