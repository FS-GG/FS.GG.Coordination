<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup><Compile Include="ExecutionTests.fs" /><Compile Include="ProcessContractAdapterTests.fs" /><Compile Include="FiniteCustodyWindowTests.fs" /><Compile Include="FiniteCustodyTransportTests.fs" /><Compile Include="PortableWorkspaceContractTests.fs" /><Compile Include="PortableHostAllocationTests.fs" /><Compile Include="PortableHostExecutorTests.fs" /><Compile Include="PortableWorkspaceExecutorTests.fs" /><Compile Include="LearningOperationalWindowTests.fs" /><Compile Include="PreparedAttemptReplayTests.fs" /><Compile Include="ManagedOwnershipCaptureTests.fs" /></ItemGroup>
  <ItemGroup><PackageReference Include="FsQuint" /><PackageReference Include="Microsoft.NET.Test.Sdk" /><PackageReference Include="xunit" /><PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" /></ItemGroup>
  <ItemGroup><ProjectReference Include="..\..\src\FS.GG.Coordination.Orchestration.Execution\FS.GG.Coordination.Orchestration.Execution.fsproj" /></ItemGroup>
  <ItemGroup><Content Include="..\..\contracts\portable-workspace\v1\examples\*.json" Link="Contracts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
<ItemGroup><Content Include="..\..\contracts\portable-workspace\v1\supplier-evidence-sizing-vectors.json" Link="Contracts\supplier-evidence-sizing-vectors.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
