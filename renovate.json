{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["nuget"],
  "packageRules": [
    { "matchPackageNames": ["*"], "enabled": false },
    {
      "matchPackageNames": ["FsQuint", "FsQuint.Tooling"],
      "enabled": true,
      "groupName": "FsQuint",
      "rangeStrategy": "pin",
      "automerge": false
    }
  ]
}
